<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Docket.app's Info.plist; scripts/macos-bundle.sh fills in
     the @...@ values. CFBundleIdentifier must match BundleID in
     internal/desktop/options.go: macOS only posts notifications for an app
     with a bundle identifier. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Docket</string>
	<key>CFBundleDisplayName</key>
	<string>Docket</string>
	<key>CFBundleIdentifier</key>
	<string>dev.devenjarvis.docket</string>
	<key>CFBundleExecutable</key>
	<string>docket</string>
	<key>CFBundleIconFile</key>
	<string>icons</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Docket</string>
</dict>
</plist>
