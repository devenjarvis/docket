+import { toISODate, parseISODate } from "./dates";
+
+test("keeps the picked day in a UTC-negative zone", () => {
+  process.env.TZ = "America/Los_Angeles";
+  const picked = new Date(2026, 10, 3, 22, 30);
+  expect(toISODate(picked)).toBe("2026-11-03");
+  expect(parseISODate("2026-11-03").getDate()).toBe(3);
+});
