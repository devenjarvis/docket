 import { http } from "../lib/http";
+import { backoff, sleep } from "./backoff";
 import { markFailed, markDelivered } from "./store";
 import type { Endpoint, WebhookEvent } from "./types";
 
+export const MAX_ATTEMPTS = 5;
+
 /**
- * Sends one webhook event to one customer endpoint.
+ * Delivers one webhook event to one customer endpoint, retrying
+ * failures with exponential backoff.
  * Called by the worker pool, one event per worker slot.
  */
-export async function send(event: WebhookEvent, endpoint: Endpoint) {
-  const res = await http.post(endpoint.url, event.payload, {
-    timeout: 5000,
-    headers: signatureHeaders(event, endpoint),
-  });
-  if (!res.ok) {
-    await markFailed(event.id, res.status);
-    return;
+export async function deliver(event: WebhookEvent, endpoint: Endpoint) {
+  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
+    const res = await http
+      .post(endpoint.url, event.payload, {
+        timeout: 5000,
+        headers: signatureHeaders(event, endpoint),
+      })
+      .catch(toTimeoutResult);
+    if (res.ok) {
+      await markDelivered(event.id, attempt);
+      return;
+    }
+    if (!isRetryable(res)) break;
+    if (attempt < MAX_ATTEMPTS) await sleep(backoff(attempt));
   }
-  await markDelivered(event.id);
+  await markFailed(event.id, MAX_ATTEMPTS);
+}
+
+function isRetryable(res: { status: number }) {
+  return res.status === 0 || res.status === 429 || res.status >= 500;
+}
+
+function toTimeoutResult() {
+  return { ok: false, status: 0 };
 }
 
 function signatureHeaders(event: WebhookEvent, endpoint: Endpoint) {
