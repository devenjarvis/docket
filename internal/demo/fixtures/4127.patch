diff --git a/src/delivery/backoff.ts b/src/delivery/backoff.ts
new file mode 100644
index 0000000..f827de1
--- /dev/null
+++ b/src/delivery/backoff.ts
@@ -0,0 +1,10 @@
+/** Delay before retry number `attempt` (1-based): 1 s, 2 s, 4 s, 8 s, with jitter. */
+export function backoff(attempt: number): number {
+  const base = 1000 * 2 ** (attempt - 1);
+  const jitter = Math.random() * 0.2 * base;
+  return base + jitter;
+}
+
+export function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
