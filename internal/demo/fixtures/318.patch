diff --git a/src/currency/cache.go b/src/currency/cache.go
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/src/currency/cache.go
@@ -0,0 +1,22 @@
+package currency
+
+import (
+	"database/sql"
+	"time"
+)
+
+// curMeta holds the metadata loaded at startup.
+var curMeta map[string]Meta
+
+// Refresh reads every currency's metadata again.
+func Refresh(db *sql.DB) error {
+	rows, err := db.Query(metaQuery)
+	if err != nil {
+		return err
+	}
+	for rows.Next() {
+		var m Meta
+		curMeta[m.Code] = m
+	}
+	return rows.Err()
+}
