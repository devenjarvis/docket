{
  "name": "Overprint",
  "version": 2,
  "meta": {
    "source": "github",
    "repo": "devenjarvis/docket",
    "file": "internal/web/static/docket.css",
    "note": "docket.css is the implementation; internal/web/tokens_test.go fails when the two disagree, and contrast_test.go when a pair below drops under its minimum."
  },
  "color": {
    "modes": [
      {
        "id": "light",
        "name": "Light: ink on paper"
      },
      {
        "id": "dark",
        "name": "Dark: the same drums on black stock"
      }
    ],
    "default": "black-tomato",
    "tokens": [
      {
        "name": "film",
        "usage": "The table the pages lie on: the window behind every sheet, with a faint speckle of both drums."
      },
      {
        "name": "sheet",
        "usage": "A page: the paper every screen is printed on."
      },
      {
        "name": "sunk",
        "usage": "Wells: code, inputs, the tab strip, a hovered row, rows past the time you have."
      },
      {
        "name": "ink",
        "usage": "The key drum: linework, headings, frames, the primary button, a current tab. What is in the pull request."
      },
      {
        "name": "text",
        "usage": "Body text: the key drum at full strength."
      },
      {
        "name": "text-2",
        "usage": "Secondary text: ledes, details under a title."
      },
      {
        "name": "text-3",
        "usage": "Meta: column heads, timestamps, hints. At least 4.5:1 on sheet, sunk and film."
      },
      {
        "name": "hair",
        "usage": "Hairlines between rows and cells. Never text, never a control's only edge."
      },
      {
        "name": "pencil",
        "usage": "The agent: dashed rules and labels on evidence, proofs and Docket's reasoning, which is also set in italic."
      },
      {
        "name": "pencil-wash",
        "usage": "Fill inside anything the agent says or did."
      },
      {
        "name": "spot",
        "usage": "The spot drum: only ever yours. A fill (the triangle, a chosen option, the offset under your action and your panel), never text. The masthead's misregistered wordmark is its one decorative print."
      },
      {
        "name": "spot-wash",
        "usage": "A lighter pass of the spot drum: the ground of Your call, a step held for you, a banner you must read."
      },
      {
        "name": "spot-ink",
        "usage": "The spot drum where it must carry text or a control's edge, overprinted with the key drum until it reads: a red stamp, .text-red."
      },
      {
        "name": "on-spot",
        "usage": "Text on a spot fill."
      },
      {
        "name": "add",
        "usage": "Diff: an added line, a tint of the key drum. Diffs never use the spot drum."
      },
      {
        "name": "add-ink",
        "usage": "Text on add."
      },
      {
        "name": "del",
        "usage": "Diff: a removed line's fill, always struck through."
      },
      {
        "name": "del-ink",
        "usage": "Text on del."
      },
      {
        "name": "on-ink",
        "usage": "Text on a key-drum fill: the primary button, your action, a solid stamp, the toast."
      }
    ],
