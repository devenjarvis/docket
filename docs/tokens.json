  "spacing": {
    "note": "Everything sits on the 8 px unit --u; components write multiples as calc(var(--u) * n).",
    "tokens": [
      {
        "name": "u-half",
        "value": "4px",
        "usage": "Tight rows of stamps (.gap-s, .mt-s)."
      },
      {
        "name": "u",
        "value": "8px",
        "usage": "--u, the unit. Gaps inside a control group."
      },
      {
        "name": "u-1.5",
        "value": "12px",
        "usage": "Cell padding, gaps inside a block."
      },
      {
        "name": "u-2",
        "value": "16px",
        "usage": "Gap between items in a row, padding of a pencil box."
      },
      {
        "name": "u-3",
        "value": "24px",
        "usage": "Padding of Your call; the page gutter."
      },
      {
        "name": "u-4",
        "value": "32px",
        "usage": "Padding of a sheet body; between blocks; above an inbox band."
      },
      {
        "name": "u-5",
        "value": "40px",
        "usage": "Between sections of the full diff."
      }
    ]
  },
  "radius": {
    "note": "Corners are square.",
    "tokens": [
      {
        "name": "radius-none",
