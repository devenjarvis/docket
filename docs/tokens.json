  "stroke": {
    "note": "Lines are printed, so they are a little heavy.",
    "tokens": [
      {
        "name": "hairline",
        "value": "1px",
        "usage": "Rows and cells."
      },
      {
        "name": "line",
        "value": "2px",
        "usage": "--line: buttons, rules, frames of a diff, a chart or a before/after."
      },
      {
        "name": "heavy",
        "value": "3px",
        "usage": "--heavy: a sheet's frame, Your call, a band's rule, a chosen option."
      }
    ]
  },
  "offset": {
    "note": "Misregistration, not shadow: a hard second print, never blurred.",
    "tokens": [
      {
        "name": "off",
        "value": "4px",
        "usage": "--off: how far the spot drum lands from the key drum under your action, a banner and the toast; twice that under Your call."
      }
    ]
  }
}